[Unit]
Description=TreeFleet UI (127.0.0.1:8765)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=treefleet
Group=treefleet
# Keep cwd outside the target git repo so UI run artifacts land in
# /var/lib/treefleet/runs instead of dirtying /var/lib/treefleet/repo (prepare_repo).
WorkingDirectory=/var/lib/treefleet
EnvironmentFile=-/etc/treefleet/idle.env
Environment=TREEFLEET_CONFIG=/etc/treefleet/treefleet.toml
Environment=HOME=/home/treefleet
Environment=AWS_DEFAULT_REGION=ap-south-1
Environment=AWS_REGION=ap-south-1
Environment=PARAMETER_PREFIX=/treefleet
# "+" runs the renderer as root so it can write /etc/treefleet/env (0600 treefleet).
# Source that file in ExecStart: systemd reads EnvironmentFile before ExecStartPre,
# so a pre-start re-render would otherwise leave the main process on a stale env.
ExecStartPre=+/usr/local/lib/treefleet/render-env.sh
# Re-apply gh HTTPS credential helper after env render (token stays in 0600 env file).
# Needed when GH_TOKEN was added after first bootstrap; ProtectHome is read-only for the main process.
ExecStartPre=+/usr/local/lib/treefleet/setup-host.sh
ExecStart=/bin/bash -c 'set -a; source /etc/treefleet/env; set +a; exec /opt/treefleet/.venv-orch/bin/treefleet ui --repo /var/lib/treefleet/repo --port 8765 --token-file /var/lib/treefleet/ui.token'
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/treefleet /etc/treefleet /opt/treefleet /home/treefleet

[Install]
WantedBy=multi-user.target
